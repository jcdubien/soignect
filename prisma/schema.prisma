generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum ProfileType {
  REMPLACANT  // remplacement court terme, période définie
  ASSISTANT   // poste long terme (>= minMonths mois)
  TITULAIRE   // cabinet / titulaire
}

enum SwipeDirection {
  LEFT
  RIGHT
}

enum SubscriptionPlan {
  FREE
  PREMIUM    // 9€/mois — boost +5, accès scores remplaçants
  BOOST      // 29€/mois — boost +8, badge prioritaire, stats avancées
  STRUCTURE  // Structures privées — 89€/mois + 20€/contrat (metered, section 7)
}

enum MissionType {
  REMPLACEMENT
  ASSISTANAT
  COLLABORATION
}

enum ZonageType {
  NON_PRIORITAIRE  // Zone 4 ARS — offre élevée
  INTERMEDIAIRE    // Zone 3 ARS — offre intermédiaire
  SOUS_DOTEE       // Zone 2 ARS — autres professions/territoires
  TRES_SOUS_DOTEE  // Zone 1 ARS — désert médical
}

enum Profession {
  KINESITHERAPEUTE
  INFIRMIER
  ORTHOPHONISTE
  SAGE_FEMME
  MEDECIN
}

enum Region {
  GUADELOUPE
  SAINT_MARTIN
  SAINT_BARTH
  MARTINIQUE
  GUYANE
  REUNION
  MAYOTTE
  METROPOLE
}

enum PostType {
  TITULAIRE
  ASSOCIE
  ASSISTANT
  COLLABORATION
  REMPLACEMENT_REGULIER  // legacy — retiré du formulaire (section 5), conservé pour données existantes
}

// Nature d'un titulaire — distinction explicite Cabinet libéral vs Structure privée
// (EHPAD, clinique, SSR). Remplace le proxy isEmployeur pour la segmentation/billing.
enum TitulaireKind {
  CABINET
  STRUCTURE
}

enum BriqueStatus {
  // Titulaire (poste 1 auto)
  PRESENT
  ABSENT_CONGE
  ABSENT_MALADIE
  ABSENT_FORMATION
  // Poste assistant / collaborateur
  OCCUPE
  PREAVIS
  RECHERCHE
  NON_COUVERT
  FERME
  // Brique remplaçant ponctuel
  CONFIRME
  EN_ATTENTE
  ANNULE
  // Dates bloquées par le remplaçant (vacances, vie perso)
  INDISPONIBLE
}

// Statut d'une mise en relation (section 12 recettage)
enum MatchStatus {
  EN_ATTENTE
  DISCUSSION
  CONFIRME
  DECLINE
  EXPIRE
}

// Suivi HUMAIN d'une brique du Planning (section 200) — troisième axe, à ne confondre
// ni avec BriqueStatus (état du créneau, qui pilote la couleur) ni avec MatchStatus (état
// technique de la relation). Il note ce que le titulaire a fait ou attend, hors plateforme.
//
// RÈGLE DE COMPOSITION : n'y mettre QUE ce que la plateforme ne peut pas savoir seule.
// « Contrat édité » a été explicitement écarté (12/08) : le produit connaît déjà l'état réel
// d'un contrat (MatchStatus, routes de signature). Un drapeau manuel en parallèle finirait par
// le contredire le jour où personne ne le remet à jour — la famille de défaut la plus coûteuse
// de ce produit, « l'écran affirme ce qu'il n'a pas vérifié ». Un cran de ce genre doit être
// DÉRIVÉ de l'état réel, jamais saisi.
enum SuiviStatut {
  A_RELANCER
  APPEL_FAIT
  REPONSE_ATTENDUE
  ECHANGE_HORS_PLATEFORME
  SANS_SUITE
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String
  role             Role      @default(USER)
  profile          Profile?
  resetToken       String?
  resetTokenExpiry DateTime?
  activeProfileId  String?
  // Notifications (section 50-51)
  phone            String?
  phoneCountry     String?   @default("GP")
  whatsappOptIn    Boolean   @default(false)
  emailOptIn       Boolean   @default(true)
  // Consentement légal à l'inscription (section 150) — horodatage de l'acceptation des
  // CGU/CGV + confidentialité + mentions légales. Null = pas d'acceptation enregistrée.
  acceptedTermsAt  DateTime?
  // Opt-out par type (section notifications recruteur) — la consultation d'annonce
  // est fréquente : on la coupe indépendamment du consentement email global.
  notifyConsultation Boolean @default(true)
  // Poste cabinet auquel ce compte ASSISTANT est rattaché (section 153) — double casquette.
  // Un compte n'est rattaché qu'à UN poste à la fois (unicité côté CabinetPost.linkedUserId).
  assistantPost    CabinetPost? @relation("AssistantPost")
  // Notifications in-app (section 155) — canal d'affichage en plus des emails.
  notifications    Notification[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// Identité professionnelle — pas de dates ici
model Profile {
  id       String      @id @default(cuid())
  userId   String      @unique
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type     ProfileType
  name     String?     // Nom du cabinet ou du professionnel
  photoUrl String?
  // Photos secondaires optionnelles (section 3) — jusqu'à 2
  secondaryPhotoUrl1 String?
  secondaryPhotoUrl2 String?
  bio      String?     @db.VarChar(300)
  bioTinder String?    @db.VarChar(700)  // "Je suis / Je cherche / J'aspire à" (700 max côté cabinet, section 123)

  // Géographie & profession
  profession           Profession @default(KINESITHERAPEUTE)
  region               Region     @default(GUADELOUPE)
  zonage               ZonageType?
  institutionalPartner Boolean    @default(false) // CPTS / ARS / Collectivité

  // Pondération feed
  weight    Float     @default(1.0)
  isPaid    Boolean   @default(false)
  paidUntil DateTime?

  // Désirabilité & abonnement
  desirabilityScore    Float            @default(0)     // 0 à 10 — composante du score d'affinité
  desirabilityOverride Float?                           // Override admin (priorité absolue)
  desirabilityExpiry   DateTime?                        // Expiration du boost manuel
  subscriptionPlan     SubscriptionPlan @default(FREE)
  isFounding           Boolean          @default(false) // Cabinet fondateur = score 10 permanent

  // Stripe — pour le metered billing des structures (section 7)
  stripeCustomerId     String?
  stripeSubscriptionId String?

  // Bascule individuelle vers le payant (section 99/100) — date d'atteinte d'un des 2
  // critères (contrat signé OU usage soutenu). Renseigné = plus couvert par le mode gratuit
  // global (après période de grâce). Null = couvert par freeAccessMode tant qu'actif.
  billingTriggeredAt   DateTime?

  // Notation agrégée (mise à jour à chaque Rating)
  ratingAvg   Float?
  ratingCount Int    @default(0)

  // Flexibilité sur les dates (0=exact, 1=±3j, 2=±1sem, 3=±2sem, 4=±1mois)
  dateFlexibility Int @default(0)

  // Recherche de logement (section 120) — signal structuré du remplaçant pour le
  // bonus logement du score d'affinité (match binaire avec Mission.logementPropose).
  rechercheLogement Boolean @default(false)

  // Besoin d'un véhicule (feature terrain) — symétrique de rechercheLogement : signal du
  // remplaçant pour le bonus véhicule du score (match binaire avec Mission.vehiculePropose).
  rechercheVehicule Boolean @default(false)

  // Attentes de cadre d'exercice (section 190) — même modèle binaire que rechercheLogement :
  // ces critères n'entrent dans le score QUE si le candidat les exprime. Non cochés, leur poids
  // est redistribué sur le socle, jamais laissé en trou (renormalisation).
  rechercheSecretariat Boolean @default(false)

  // Souhait d'exercer en structure coordonnée (MSP / centre de santé / équipe de soins
  // primaires). Ce n'est pas un confort : l'exercice coordonné ouvre l'accès direct sans
  // prescription médicale préalable (Avenant 7), donc une autonomie de pratique réelle.
  rechercheExerciceCoordonne Boolean @default(false)

  // Suggestion « et si vous cherchiez un poste long terme ? » (section 191) — date de fermeture
  // du bandeau par l'utilisateur. Portée par le Profile et non par le navigateur : une
  // suggestion écartée doit le rester d'un appareil à l'autre, et la date sert à mesurer
  // le test (combien la ferment, combien publient ensuite).
  suggestionAssistanatVueAt DateTime?

  // Ouverture aux postes salariés (section 154) — REMPLACANT/ASSISTANT qui accepte aussi
  // les contrats salariés (CDD/CDI/Stage/Vacation) publiés par les comptes STRUCTURE.
  // Défaut false = le candidat ne voit pas / n'est pas visible pour le salariat (opt-in).
  ouvertSalariat Boolean @default(false)

  // Vérification RPPS via API ANS (section 30)
  isVerified  Boolean @default(false)

  // Identité contractuelle (section 150) — injectée dans le PDF de contrat, obligatoire
  // avant génération. Praticiens : rpps + numeroOrdre + adresse. Structures : siret + adresse.
  rpps        String?
  numeroOrdre String?
  adresse     String?
  siret       String?

  // Établissement employeur : terminologie CDI/CDD/Vacation (section 37)
  isEmployeur Boolean @default(false)
  // Distinction explicite Cabinet/Structure (segmentation & billing, section 7/99)
  titulaireKind TitulaireKind @default(CABINET)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  missions                  Mission[]
  swipesGiven               Swipe[]          @relation("SwiperProfile")
  ratingsGiven              Rating[]         @relation("RaterProfile")
  ratingsReceived           Rating[]         @relation("RatedProfile")
  messagesSent              Message[]
  matchesA                  Match[]          @relation("MatchProfileA")
  matchesB                  Match[]          @relation("MatchProfileB")
  cabinetRatingsGiven       CabinetRating[]  @relation("CabinetRatingRater")
  cabinetRatingsReceived    CabinetRating[]  @relation("CabinetRatingRated")
  remplacantRatingsGiven    RemplacantRating[] @relation("RemplacantRatingRater")
  remplacantRatingsReceived RemplacantRating[] @relation("RemplacantRatingRated")
  cabinetPosts              CabinetPost[]    @relation("CabinetPosts")

  @@index([type, isActive])
}

// Une annonce = une mission (plusieurs par profil possible)
model Mission {
  id          String   @id @default(cuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title       String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  location    String
  specialties String[]

  // Phrase libre (280 signes) — ex: "Je recherche un cabinet sport en Guadeloupe"
  pitch     String? @db.VarChar(700)  // accroche annonce (700 max côté cabinet, section 123/186)
  bioTinder String? @db.VarChar(700)  // Bio spécifique à cette annonce (700 max côté cabinet, section 123)

  // REMPLACANT / TITULAIRE (remplacement) : dates définies
  startDate DateTime?
  endDate   DateTime?

  // ASSISTANT : durée minimale en mois (ex: 3, 6, 12)
  minMonths Int?

  // REMPLACANT : taux de rétrocession souhaité (%)
  retrocessionRate Int?

  // Type de contrat (section 20 — 3 types)
  missionType MissionType @default(REMPLACEMENT)

  // Zonage ARS (calculé depuis la commune à la création)
  zonage ZonageType?

  // Macro-zones géographiques souhaitées / couvertes (section 138) — multi-sélection.
  // La commune (location) reste l'ancre précise (contrat PDF, zonage ARS, affichage) ;
  // ces zones élargissent la zone de recherche pour le score d'affinité géo.
  zones ZoneGeographique[] @default([])

  // Distribution Facebook (section 12)
  facebookPostId   String?
  facebookPostedAt DateTime?
  autoPostFacebook Boolean   @default(true)

  // Flexibilité sur les dates (0=exact, 1=±3j, 2=±1sem, 3=±2sem, 4=±1mois)
  dateFlexibility Int @default(0)

  // Logement proposé avec l'annonce (section 120) — bonus logement du score d'affinité
  // (match binaire avec Profile.rechercheLogement du remplaçant).
  logementPropose Boolean @default(false)

  // Véhicule mis à disposition avec l'annonce (feature terrain, annonces réelles) — bonus
  // véhicule du score, symétrique de logementPropose (match binaire avec Profile.rechercheVehicule).
  vehiculePropose Boolean @default(false)

  // Secrétariat présent au cabinet (section 190) — bonus du score, même structure binaire que
  // le logement (match avec Profile.rechercheSecretariat). Allège la charge administrative,
  // argument récurrent des annonces réelles pour un remplaçant comme pour un assistant.
  secretairePresente Boolean @default(false)

  // Exercice coordonné : MSP, centre de santé, ou équipe de soins primaires (section 190).
  // PORTÉE PROFESSIONNELLE, pas un agrément décoratif — l'exercice coordonné ouvre l'accès
  // direct sans prescription médicale préalable, jusqu'à 8 séances (Avenant 7). C'est pourquoi
  // il pèse plus lourd que les trois autres bonus dans le barème (lib/compatibilite).
  //
  // Porté par la Mission et non par le Profile, par symétrie avec logementPropose et parce
  // qu'un cabinet multi-sites peut n'être coordonné que sur l'un d'eux.
  exerciceCoordonne Boolean @default(false)

  // Demi-journées libres par semaine (feature terrain) — critère qualité de vie annoncé
  // spontanément par les titulaires. Affichage seul (hors score). Cap UI 0-10.
  demiJourneesLibres Int?

  // Rémunération brute mensuelle en euros (section 194) — équivalent SALARIÉ du CA estimé.
  // Colonne distincte et non réutilisation de caMensuelEstime : un chiffre d'affaires et un
  // salaire brut ne se comparent pas, ne se calculent pas pareil et n'intéressent pas les mêmes
  // personnes. Les mélanger dans une colonne rendrait toute analyse ultérieure fausse — et le
  // formulaire employeur demandait justement un « CA mensuel estimé » à qui embauche.
  remunerationBrute Int?

  // CA mensuel estimé en euros (feature terrain) — publié spontanément par certains titulaires.
  // Optionnel, affichage seul. Alimentera plus tard le calculateur de revenu net (B4).
  caMensuelEstime Int?

  // Texte libre de l'annonce (refonte saisie texte-libre + extraction IA) — source de vérité
  // rédigée par l'utilisateur. Les champs structurés (dates, commune, taux, CA…) en sont
  // extraits puis CONFIRMÉS. TEXT (sans limite) : une annonce riche dépasse le cap 700 du pitch.
  rawText String? @db.Text

  // Lien Planning Board (section 28)
  cabinetPostId String?
  cabinetPost   CabinetPost? @relation("PostMissions", fields: [cabinetPostId], references: [id])
  singleSlot    Boolean      @default(false)
  maxCandidates Int          @default(10)

  // Statut manuel de la brique Planning Board (section 33)
  briqueStatus    BriqueStatus @default(RECHERCHE)
  statusUpdatedAt DateTime?
  // Note libre de suivi. La colonne, sa validation Zod et son AFFICHAGE existaient depuis
  // l'origine ; seule la saisie manquait — le champ est resté muet des mois (section 200).
  statusNote      String?      @db.VarChar(200)

  // Suivi humain de la brique (section 200) — voir SuiviStatut. Nullable = aucun suivi noté.
  suiviStatut     SuiviStatut?
  suiviUpdatedAt  DateTime?

  // Nom du remplaçant/successeur matché — affiché sur le segment RECRUTEMENT/CONFIRME (section 1c / 6)
  matchedName     String?      @db.VarChar(120)

  // Date de départ prévue — déclencheur silencieux Confirmé → Recrutement/Non couvert (section 6)
  departureDate   DateTime?

  // Planning Board section 43 — déclaration de vacance titulaire
  isSelfPresence Boolean @default(false)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  swipesReceived Swipe[] @relation("SwipedMission")
  matchesA       Match[] @relation("MatchMissionA")
  matchesB       Match[] @relation("MatchMissionB")

  @@index([profileId, isActive])
  @@index([location, isActive])
}

// Macro-zones géographiques Guadeloupe (section 138) — palier intermédiaire
// avant l'architecture temps de trajet national (section 135).
enum ZoneGeographique {
  CENTRE_CAP_EXCELLENCE
  SUD_GRANDE_TERRE
  NORD_GRANDE_TERRE
  SUD_BASSE_TERRE
  NORD_BASSE_TERRE
  MARIE_GALANTE
  LES_SAINTES
  LA_DESIRADE
  SAINT_MARTIN
  SAINT_BARTHELEMY
}

// Table de correspondance commune → zone (mapping figé, section 138).
// Le mapping applicatif de référence vit dans src/lib/communes.ts (COMMUNE_ZONE) ;
// cette table le matérialise en base pour d'éventuelles analyses SQL par zone
// (ex: futur TensionScore par zone, sections 82-84).
model CommuneZone {
  commune String           @id
  zone    ZoneGeographique
}

// Un profil swipe sur une mission (pas un autre profil)
model Swipe {
  id              String         @id @default(cuid())
  swiperId        String
  swiper          Profile        @relation("SwiperProfile", fields: [swiperId], references: [id])
  swipedMissionId String
  swipedMission   Mission        @relation("SwipedMission", fields: [swipedMissionId], references: [id])
  direction       SwipeDirection
  affinityScore   Float?                         // Score total 0-100 calculé par DeepSeek
  scoreDetails    Json?                          // {dates, geo, specialty, bio, desirability}
  createdAt       DateTime       @default(now())

  @@unique([swiperId, swipedMissionId])
}

// Match entre deux profils, déclenché par deux missions
model Match {
  id         String   @id @default(cuid())
  profileAId String
  profileA   Profile  @relation("MatchProfileA", fields: [profileAId], references: [id])
  profileBId String
  profileB   Profile  @relation("MatchProfileB", fields: [profileBId], references: [id])
  missionAId String?
  missionA   Mission? @relation("MatchMissionA", fields: [missionAId], references: [id])
  missionBId String?
  missionB   Mission? @relation("MatchMissionB", fields: [missionBId], references: [id])
  aiScore           Float?
  aiFactors         Json?
  status            MatchStatus @default(EN_ATTENTE)
  ratings           Rating[]
  cabinetRatings    CabinetRating[]
  remplacantRatings RemplacantRating[]
  messages          Message[]
  createdAt         DateTime @default(now())

  // Signature par photo (section 61) — chemin Storage bucket "signatures" (non public)
  signatureTitulaireUrl   String?
  signatureTitulaireAt    DateTime?
  signatureRemplacantUrl  String?
  signatureRemplacantAt   DateTime?

  @@unique([profileAId, profileBId])
}

model Message {
  id        String   @id @default(cuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  senderId  String
  sender    Profile  @relation(fields: [senderId], references: [id])
  content   String   @db.VarChar(1000)
  createdAt DateTime @default(now())
  // Rappel 24h envoyé pour ce message resté sans réponse (section 9) — évite les doublons
  reminderSentAt DateTime?
  // Lecture par le destinataire (section 155) — null = non lu. Renseigné quand le
  // destinataire (senderId != lui) ouvre la conversation.
  readAt    DateTime?

  @@index([matchId, createdAt])
}

model Rating {
  id        String   @id @default(cuid())
  raterId   String
  rater     Profile  @relation("RaterProfile", fields: [raterId], references: [id])
  ratedId   String
  rated     Profile  @relation("RatedProfile", fields: [ratedId], references: [id])
  matchId   String?
  match     Match?   @relation(fields: [matchId], references: [id])
  score     Int
  comment   String?  @db.VarChar(500)
  createdAt DateTime @default(now())

  @@unique([raterId, ratedId, matchId])
}

// Notation d'un cabinet par un remplaçant (publique)
model CabinetRating {
  id           String   @id @default(cuid())
  raterId      String   // REMPLACANT qui note
  rater        Profile  @relation("CabinetRatingRater", fields: [raterId], references: [id])
  ratedId      String   // TITULAIRE noté
  rated        Profile  @relation("CabinetRatingRated", fields: [ratedId], references: [id])
  matchId      String?
  match        Match?   @relation(fields: [matchId], references: [id])
  recommended  Boolean  // true = recommande, false = ne recommande pas
  // Critères détaillés — optionnels (remplis si l'utilisateur veut préciser)
  scoreAccueil   Int?
  scoreMateriel  Int?
  scoreContrat   Int?
  scoreAmbiance  Int?
  scoreGlobal    Float?  // calculé si critères renseignés, sinon null
  comment      String?  @db.VarChar(500)
  // Modération : false = en attente de validation admin avant affichage public
  isPublished  Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@unique([raterId, ratedId, matchId])
}

// Évaluation d'un remplaçant par un cabinet (privée)
model RemplacantRating {
  id           String   @id @default(cuid())
  raterId      String   // TITULAIRE qui évalue
  rater        Profile  @relation("RemplacantRatingRater", fields: [raterId], references: [id])
  ratedId      String   // REMPLACANT évalué
  rated        Profile  @relation("RemplacantRatingRated", fields: [ratedId], references: [id])
  matchId      String?
  match        Match?   @relation(fields: [matchId], references: [id])
  recommended         Boolean  // true = recommande, false = ne recommande pas
  // Critères détaillés — optionnels (PAS de commentaire — art. R.4321-99)
  scorePonctualite    Int?
  scoreQualiteSoins   Int?
  scoreDossierPatient Int?
  scoreCommunication  Int?
  scoreGlobal         Float?
  createdAt    DateTime @default(now())

  @@unique([raterId, ratedId, matchId])
}

// Données APL DREES par commune — section 22
// Alimenté par scripts/update_apl.py (cron annuel)
model CommuneAPL {
  id                  Int      @id @default(autoincrement())
  codeInsee           String   @unique
  commune             String
  departement         String
  aplKine             Float?
  aplInfirmier        Float?
  aplMedecin          Float?
  aplSageFemme        Float?
  aplOrthophoniste    Float?
  boostKine           Int      @default(0)
  boostInfirmier      Int      @default(0)
  boostMedecin        Int      @default(0)
  boostSageFemme      Int      @default(0)
  boostOrthophoniste  Int      @default(0)
  updatedAt           DateTime @default(now()) @updatedAt
}

// Poste du Planning Board (section 28) — un poste = une ligne de timeline
model CabinetPost {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  cabinetId    String
  cabinet      Profile   @relation("CabinetPosts", fields: [cabinetId], references: [id])
  label        String    // "Poste 1", "Dr Marie L.", etc.
  postType     PostType  @default(REMPLACEMENT_REGULIER)
  maxSlots     Int       @default(1)
  noticeMonths Int       @default(3)
  autoAlert    Boolean   @default(true)
  autoPublish  Boolean   @default(false)
  isActive     Boolean   @default(true)
  missions     Mission[] @relation("PostMissions")

  // Siège du TITULAIRE DU COMPTE — sa propre ligne de planning (section 188).
  // Attention au vocabulaire : ce siège est celui du détenteur du compte cabinet, pas
  // « du titulaire » au sens générique. Un cabinet peut compter plusieurs titulaires ;
  // les autres sont des postes ordinaires (PostType.TITULAIRE / ASSOCIE). Le modèle ne
  // sait pas encore représenter un co-titulaire disposant de droits sur le cabinet —
  // sujet ouvert (statut différencié / administrateur de cabinet).
  //
  // Avant, le détenteur du compte n'avait AUCUN poste : ses congés étaient des Mission marquées
  // isSelfPresence, un objet qui est une Mission mais que chaque consommateur devait penser
  // à exclure. Oublis constatés : congés publiquement consultables, cartes de partage
  // générées, congés swipables dans le feed, suppression bloquée par le swipe ainsi créé.
  // Avec un vrai poste, une absence redevient une période normale : FERME (off) ou
  // RECHERCHE (annonce en ligne) — les filtres existants sur briqueStatus suffisent.
  // Un seul par cabinet, créé automatiquement, non supprimable.
  isOwnerSeat  Boolean   @default(false)

  // Compte ASSISTANT rattaché à ce poste (section 153) — double casquette employeur/employé.
  // @unique : un compte User ne peut être rattaché qu'à UN SEUL poste à la fois (les NULL
  // multiples sont autorisés en Postgres). Null = poste géré uniquement par le titulaire.
  linkedUserId String?   @unique
  linkedUser   User?     @relation("AssistantPost", fields: [linkedUserId], references: [id])

  // Note de suivi du POSTE (section 200). C'est elle qui couvre les ZONES NON COUVERTES :
  // un trou de planning n'est aucun objet en base — c'est un intervalle calculé entre deux
  // briques. L'accrocher à un triplet (poste + début + fin) la rendrait orpheline au premier
  // décalage de dates, ce qui arrive (bug B9, dates d'absence modifiées). Le poste, lui, est
  // stable : la note lui survit quel que soit le redécoupage des périodes.
  suiviNote      String?   @db.VarChar(500)
  suiviUpdatedAt DateTime?
}

// Back-office de traçabilité (section 86) — table d'événements horodatés, écrite
// en parallèle des tables métier pour l'analyse statistique future (pitch ARS/CGSS).
// Alimentée par de simples inserts fire-and-forget dans les routes existantes.
model TraceEvent {
  id          String   @id @default(cuid())
  eventType   String   // "MISSION_PUBLISHED", "SWIPE_RIGHT", "MATCH_CREATED", "CONTRACT_SIGNED", "PLANNING_ACTIVE", ...
  missionId   String?
  matchId     String?
  profileId   String?  // acteur (ex: cabinet actif sur le Planning Board — section 100 critère 2)
  commune     String?  // dénormalisé pour agrégation géographique sans jointures
  profession  String?
  missionType String?
  occurredAt  DateTime @default(now())
  metadata    Json?

  @@index([eventType, commune, occurredAt])
  @@index([commune, profession, occurredAt])
  @@index([profileId, eventType, occurredAt])
}

// Configuration plateforme (singleton) — mode lancement gratuit (section 2).
// Tant que freeAccessMode = true, tous les comptes ont accès au Premium.
// Notifications in-app (section 155) — une entrée créée en parallèle de chaque email
// (mêmes déclencheurs : message, match, signature, consultation). readAt null = non lu.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String    // "message" | "match" | "signature" | "consultation"
  message   String    @db.VarChar(300)
  linkUrl   String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model PlatformConfig {
  id             String   @id @default(cuid())
  freeAccessMode Boolean  @default(true)
  // Blocage dur des contrats si identité contractuelle incomplète (section 150).
  // false = phase d'avertissement (non bloquant) ; true = accès contrat refusé si incomplet.
  enforceContractProfile Boolean @default(false)
  updatedAt      DateTime @updatedAt
}

// Invitation par email à rejoindre Soignect + rattachement auto à un poste (section 187).
// Permet à un titulaire d'inviter un FUTUR assistant (sans compte) : le rattachement se fait
// à la finalisation de l'inscription via /register?inviteToken=<token>.
model PosteInvitation {
  id            String   @id @default(cuid())
  cabinetPostId String
  invitedEmail  String
  token         String   @unique
  status        String   @default("PENDING") // PENDING | USED | EXPIRED
  createdAt     DateTime @default(now())
  expiresAt     DateTime

  @@index([invitedEmail])
}
