# Base de données Supabase (PostgreSQL)
DATABASE_URL=
DIRECT_URL=

# NextAuth v5
AUTH_SECRET=
AUTH_URL=

# Scoring d'affinité (DeepSeek)
DEEPSEEK_API_KEY=

# Supabase (client + serveur)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # clé serveur (bypass RLS) — uploads photo/signature

# Annuaire Santé (RPPS) — optionnel
ANS_API_KEY=

# Emails transactionnels (Resend)
RESEND_API_KEY=

# Paiements Stripe — optionnel
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM=            # Cabinet Premium 9€/mois
STRIPE_PRICE_BOOST=             # Cabinet Boost 29€/mois
STRIPE_PRICE_STRUCTURE_BASE=   # Structure privée — abonnement 89€/mois (récurrent)
STRIPE_PRICE_STRUCTURE_USAGE=  # Structure privée — 20€/contrat (metered, usage_type: metered)
STRIPE_PRICE_PREVENTION_TRAINING= # Formation Prévention — prix unique

# Moodle — service web REST avec core_user_* et enrol_manual_enrol_users autorisés
MOODLE_BASE_URL=               # ex. https://formation.soignect.fr
MOODLE_TOKEN=
MOODLE_PREVENTION_COURSE_ID=
MOODLE_STUDENT_ROLE_ID=5       # rôle Étudiant Moodle par défaut

# Cron (Vercel) — secret du job de rappel 24h /api/cron/message-reminders
CRON_SECRET=
